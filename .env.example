# Credenciales de Supabase para el pipeline ETL (Service Role Key en GitHub Actions)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=eyJ...service_role_key...

# Cadena por defecto para ejecución local
STORE_TARGET=exito
LOG_LEVEL=INFO
SKIP_UNIMPLEMENTED=false

# Google Maps Places API (New) para ingesta y geocodificación en Colombia
GOOGLE_MAPS_API_KEY=

# Gateway API de Tiendas Ara (backend on-demand y sincronización)
ARA_GW_BASE_URL=https://api-gw-prod-v1-501aqrta.ew.gateway.dev
ARA_GW_API_KEY=
